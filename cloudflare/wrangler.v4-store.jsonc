{
  "name": "eve-v4-opportunity-store",
  "main": "v4_api_worker.js",
  "compatibility_date": "2026-10-01",
  "preview_urls": false,
  "vars": {"V4_RELEASE_ENABLED": "0"},
  "durable_objects": {
    "bindings": [
      {"name": "V4_LEDGER", "class_name": "V4OpportunityLedger"}
    ]
  },
  "migrations": [
    {"tag":"v4-store-init", "new_sqlite_classes": ["V4OpportunityLedger"]}
  ]
}
